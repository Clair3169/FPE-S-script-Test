# =====================================================================
# ROBLOX AI ULTIMATE CONTROLLER — COMPLETE & STABLE
# Windows 10 | PowerShell 5.1 | Intel HD 4600
# =====================================================================

# --------- CONFIGURACIÓN BASE ----------
$ProcessName = "RobloxPlayerBeta"
$CoresUsed   = 3
$AffinityMask = 0x7           # CPU 0,1,2
$LoopDelayMS = 900
$SampleMS    = 200

# --------- LÍMITES (AJUSTADOS A TU CPU/GPU) ----------
$CpuSoftLimit = 70
$CpuHardLimit = 85
$CpuSpikeJump = 18
$MemCriticalMB = 850

# --------- IA / ADAPTACIÓN ----------
$StateFile = "$PSScriptRoot\Roblox_AI_State.json"

$AI = @{
    Sensitivity = 1.0
    Aggression  = 1.0
    Confidence  = 0.6
    FreezeCount = 0
    StableTicks = 0
}

if (Test-Path $StateFile) {
    try {
        $AI = Get-Content $StateFile | ConvertFrom-Json
    } catch {}
}

# --------- FUNCIONES ----------
function Clamp {
    param(
        [double]$Value,
        [double]$Min,
        [double]$Max
    )
    if ($Value -lt $Min) { return $Min }
    if ($Value -gt $Max) { return $Max }
    return $Value
}

function Get-CpuUsage {
    param($Process, $Cores)

    $t1 = $Process.TotalProcessorTime.TotalMilliseconds
    Start-Sleep -Milliseconds $SampleMS
    $Process.Refresh()
    $t2 = $Process.TotalProcessorTime.TotalMilliseconds

    return (($t2 - $t1) / ($SampleMS * $Cores)) * 100
}

# --------- INICIALIZACIÓN ----------
$LastCpu = 0
$CpuHistory = @()

# --------- BUCLE PRINCIPAL ----------
while ($true) {

    $p = Get-Process $ProcessName -ErrorAction SilentlyContinue
    if (-not $p) {
        Start-Sleep -Milliseconds 1200
        continue
    }

    # Afinidad fija
    if ($p.ProcessorAffinity -ne $AffinityMask) {
        $p.ProcessorAffinity = $AffinityMask
    }

    # Prioridad base
    if ($p.PriorityClass -ne "BelowNormal") {
        $p.PriorityClass = "BelowNormal"
    }

    # CPU REAL
    $Cpu = Get-CpuUsage $p $CoresUsed
    $CpuHistory += $Cpu
    if ($CpuHistory.Count -gt 6) { $CpuHistory = $CpuHistory[-6..-1] }

    # MEMORIA
    $MemMB = [math]::Round($p.WorkingSet64 / 1MB)

    # DETECCIÓN DE SPIKE
    $Spike = ($Cpu - $LastCpu) -gt $CpuSpikeJump

    # ---- LÓGICA ANTI-FREEZE ----
    if ($Cpu -gt $CpuHardLimit -or $Spike -or $MemMB -gt $MemCriticalMB) {

        $p.PriorityClass = "Idle"
        Start-Sleep -Milliseconds (120 * $AI.Sensitivity)

        $AI.FreezeCount++
        $AI.Confidence = Clamp ([double]($AI.Confidence - 0.04)) 0.3 1.0
        $AI.Aggression = Clamp ([double]($AI.Aggression + 0.06)) 0.7 1.6

    }
    elseif ($Cpu -lt $CpuSoftLimit) {

        $p.PriorityClass = "BelowNormal"
        $AI.StableTicks++

        if ($AI.StableTicks -gt 6) {
            $AI.Confidence = Clamp ([double]($AI.Confidence + 0.02)) 0.3 1.0
            $AI.Aggression = Clamp ([double]($AI.Aggression - 0.02)) 0.7 1.6
            $AI.StableTicks = 0
        }
    }

    # Sensibilidad global
    $AI.Sensitivity = Clamp ([double](1 + ($AI.Aggression - 1) * (1 - $AI.Confidence))) 0.8 1.5

    # Guardar estado IA
    try {
        $AI | ConvertTo-Json | Set-Content $StateFile
    } catch {}

    $LastCpu = $Cpu
    Start-Sleep -Milliseconds $LoopDelayMS
}
